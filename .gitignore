# Data layers (raw is immutable, clean is regenerated)
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep

# Database files
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db

# Virtual environments
venv/
venvs/
.venv/
env/
ENV/
test_venv/

# Secrets and environment variables
.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Linter and formatting
.ruff_cache/
.mypy_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo
data/users.db
